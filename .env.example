# Set these as encrypted Vercel environment variables. Never use the VITE_
# prefix: every VITE_ value is exposed to site visitors in the browser bundle.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=dimnay-portfolio-data
AWS_ENDPOINT=

# Used only by the signing function to permit uploads from your admin account.
ADMIN_EMAIL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
